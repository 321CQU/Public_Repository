#Control Center Config
CONTROL_CENTER_SERVER_NAME=control-center
CONTROL_CENTER_IMAGE=321cqu-control-center:latest
CONTROL_CENTER_EXPOSE_PORT=53214
CONTROL_CENTER_HOME_DIR=/www/services/control_center

# API Gateway Config
API_GATEWAY_SERVER_NAME=api-gateway
API_GATEWAY_IMAGE=321cqu-api-gateway:latest
API_GATEWAY_HOME_DIR=/www/services/api_gateway

# mycqu service config
MYCQU_SERVICE_SERVER_NAME=mycqu-service
MYCQU_SERVICE_IMAGE=321cqu-mycqu:latest
MYCQU_SERVICE_EXPOSE_PORT=53211
MYCQU_SERVICE_METRICS_PORT=93211
MYCQU_SERVICE_HOME_DIR=/www/services/mycqu_service

# edu admin center config
EDU_ADMIN_CENTER_SERVER_NAME=edu-admin-center
EDU_ADMIN_CENTER_IMAGE=321cqu-edu-admin-center:latest
EDU_ADMIN_CENTER_EXPOSE_PORT=53212
EDU_ADMIN_CENTER_METRICS_PORT=93212
EDU_ADMIN_CENTER_HOME_DIR=/www/services/edu_admin_center

# monitoring config
PROMETHEUS_IMAGE=prom/prometheus:latest
PROMETHEUS_PORT=9090

GRAFANA_IMAGE=grafana/grafana:latest
GRAFANA_PORT=3000
# Grafana 管理员凭据，部署时请修改为强密码
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# 代理服务凭据，部署时请填入真实值
PROXY_PASSWORD=changeme
PROXY_USERNAME=changeme
PROXY_SECRET_ID=changeme
PROXY_SIGNATURE=changeme
